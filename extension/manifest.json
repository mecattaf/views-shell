{
  "manifest_version": 3,
  "key": "",
  "name": "views-shell",
  "short_name": "views-shell",
  "version": "0.0.1",
  "description": "Control pages for the views-shell desktop shell, in ordinary Chrome tabs. Talks only to views-shell on this machine, through native messaging.",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icons/views-shell-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "omnibox": {
    "keyword": "views"
  },
  "commands": {
    "open-views-shell": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Open the views-shell control pages"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
