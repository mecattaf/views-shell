          "$ref": "#/$defs/bool"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "detail": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Id of a quickSettings page entry of this plugin."
        }
      }
    },
    "tabSlider": {
      "description": "A segmented control composed from views::MdTextButton (tonal when selected).",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "type",
        "options",
        "value",
        "action"
      ],
      "properties": {
        "type": {
          "const": "tabSlider"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "keyChips": {
      "description": "Key chips (the ported KeyboardShortcutView).",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "type",
        "keys"
      ],
      "properties": {
        "type": {
          "const": "keyChips"
        },
        "keys": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "mediaSession": {
      "description": "A media session card drawn by components/global_media_controls MediaItemUIView (linked, stock). The bound object is one session from an MPRIS source.",
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "type",
        "session"
      ],
      "properties": {
        "type": {
