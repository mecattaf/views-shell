"""views-shell: dispatch skeleton for the views-shell command line (see cli/SPEC.md).

Real today (offline): `plugin validate <dir>`, `plugin render`, `version`, `help`.
Everything else is forwarded as JSON-RPC to $XDG_RUNTIME_DIR/views-shell/views-shell.sock; no
views-shell process exists yet, so those exit 69 with "views-shell is not running".
"""
import argparse
import json
import os
import pathlib
import socket
import sys

VERSION = "0.0.0-foundation"
PROTOCOL = 1
ROOT = pathlib.Path(__file__).resolve().parent.parent
EX_UNAVAILABLE = 69

# Neutral modifier -> per-compositor spelling (schemas/keybinding-rendering.md).
MODS = {
    "scroll": {"Mod": "$mod", "Super": "Mod4", "Ctrl": "Ctrl", "Alt": "Mod1", "Shift": "Shift"},
    "niri": {"Mod": "Mod", "Super": "Super", "Ctrl": "Ctrl", "Alt": "Alt", "Shift": "Shift"},
    "hyprland": {"Mod": "$mainMod", "Super": "SUPER", "Ctrl": "CTRL", "Alt": "ALT", "Shift": "SHIFT"},
}
MODS["sway"] = MODS["scroll"]
NAMED = {"Comma": ("comma", "Comma", "comma"), "Period": ("period", "Period", "period"),
         "Slash": ("slash", "Slash", "slash"), "Grave": ("grave", "Grave", "grave"),
         "Minus": ("minus", "Minus", "minus"), "Equal": ("equal", "Equal", "equal"),
         "Semicolon": ("semicolon", "Semicolon", "semicolon")}


def die(msg, code=1):
    print(f"views-shell: {msg}", file=sys.stderr)
    sys.exit(code)


def socket_path():
    rt = os.environ.get("XDG_RUNTIME_DIR")
    return pathlib.Path(rt, "views-shell", "views-shell.sock") if rt else None


def forward(method, params, as_json):
    path = socket_path()
    if not path or not path.exists():
        die("views-shell is not running (no socket at "
            f"{path or '$XDG_RUNTIME_DIR/views-shell/views-shell.sock'})", EX_UNAVAILABLE)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(str(path))
        s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": method,
                               "params": params}) + "\n").encode())
        reply = json.loads(s.makefile().readline())
    if "error" in reply:
        die(reply["error"].get("message", "error"), reply["error"].get("data", {}).get("exit", 1))
    result = reply.get("result")
    print(json.dumps(result, indent=2) if as_json else (result if isinstance(result, str) else json.dumps(result)))


def split_key(key, comp):
    *mods, last = key.split("+")
    m = [MODS[comp][x] for x in mods]
    idx = {"scroll": 0, "sway": 0, "niri": 1, "hyprland": 2}[comp]
    if last in NAMED:
        last = NAMED[last][idx]
    elif len(last) == 1 and last.isalpha():
        last = last.lower() if comp in ("scroll", "sway") else last.upper()
    return m, last


def resolve_key(kb, manifest):
    if "key" in kb:
        return kb["key"]
    prop = kb["keyFrom"].split(".", 1)[1]
    return manifest["contributes"]["configuration"]["properties"][prop]["default"]


def render_plugin(manifest, comp):
    pid, ver = manifest["id"], manifest["version"]
    kbs = manifest.get("contributes", {}).get("keybindings", [])
    lua = manifest.get("contributes", {}).get("compositor", {}).get("scroll", {}).get("lua", [])
    if not kbs and not lua:
        return None
    out = []
    if comp in ("scroll", "sway"):
        out.append(f"# Generated by views-shell for {pid} {ver}. Do not edit: changes are\n"
                   "# overwritten. Disable the plugin or override the key in your own config.")
        for kb in kbs:
            mods, key = split_key(resolve_key(kb, manifest), comp)
            flags = (" --release" if kb.get("release") else "") + (" --locked" if kb.get("locked") else "")
            payload = f" '{json.dumps(kb['args'])}'" if kb.get("args") else ""
            out.append(f"bindsym{flags} {'+'.join(mods + [key])} nop views-shell {pid} {kb['command']}{payload}")
        if comp == "scroll":
            for f in lua:
                out.append(f"lua ~/.local/share/views-shell/plugins/{pid}/{f}")
    elif comp == "niri":
        out.append(f"// begin {pid} (generated by views-shell)\nbinds {{")
        for kb in kbs:
            if kb.get("release") or kb.get("mode"):
                continue  # not supported on niri: the entry is not registered
            mods, key = split_key(resolve_key(kb, manifest), comp)
            locked = " allow-when-locked=true" if kb.get("locked") else ""
            out.append(f'    {"+".join(mods + [key])}{locked} {{ spawn "views-shell" "call" "{pid}" "{kb["command"]}"; }}')
        out.append(f"}}\n// end {pid}")
    elif comp == "hyprland":
        for kb in kbs:
            mods, key = split_key(resolve_key(kb, manifest), comp)
            kind = "bind" + ("r" if kb.get("release") else "") + ("l" if kb.get("locked") else "")
            out.append(f"{kind} = {' '.join(mods)}, {key}, exec, views-shell call {pid} {kb['command']}")
    return "\n".join(out) + "\n"


def cmd_render(args):
    if args.enabled:
        dirs = [pathlib.Path(p) for p in json.loads(pathlib.Path(args.enabled).read_text())]
    else:
        dirs = [pathlib.Path(p) for p in args.plugin]
    if not dirs:
        die("render: name plugin directories with --plugin, or a JSON list with --enabled", 2)
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    written, niri = [], []
    for d in dirs:
        manifest = json.loads((d / "views-shell-plugin.json").read_text())
        text = render_plugin(manifest, args.compositor)
        if text is None:
            continue
        if args.compositor == "niri":
            niri.append(text)
            continue
        f = out / f"{manifest['id']}.conf"
        f.write_text(text)
        written.append(str(f))
    if niri:
        f = out / "views-shell.kdl"
        f.write_text("\n".join(niri))
        written.append(str(f))
    print(json.dumps(written) if args.json else "\n".join(written))


def cmd_validate(args):
    try:
        from jsonschema import Draft202012Validator
    except ImportError:
        die("validate needs the python jsonschema package (see tools/validate.sh)", 1)
    d = pathlib.Path(args.dir)
    schema = json.loads((ROOT / "schemas/views-shell-plugin.schema.json").read_text())
    errs = list(Draft202012Validator(schema).iter_errors(json.loads((d / "views-shell-plugin.json").read_text())))
    for e in errs:
        print(f"{'/'.join(map(str, e.path)) or '(root)'}: {e.message}", file=sys.stderr)
    if any(p.is_symlink() for p in d.rglob("*")):
        print("plugin directories may not contain symlinks", file=sys.stderr)
        errs.append(True)
    print(json.dumps({"valid": not errs}) if args.json else ("valid" if not errs else "invalid"))
    sys.exit(1 if errs else 0)


def main(argv):
    ap = argparse.ArgumentParser(prog="views-shell", description="views-shell command line (foundation skeleton)")
    ap.add_argument("--json", action="store_true")
    sub = ap.add_subparsers(dest="verb")
    sub.add_parser("version")
    c = sub.add_parser("call")
    c.add_argument("plugin")
    c.add_argument("command", nargs="?")
    c.add_argument("payload", nargs="?")
    o = sub.add_parser("open")
    o.add_argument("page", nargs="?", default="shortcuts")
    p = sub.add_parser("plugin")
    psub = p.add_subparsers(dest="pverb")
    v = psub.add_parser("validate")
    v.add_argument("dir")
    r = psub.add_parser("render")
    r.add_argument("--compositor", required=True, choices=["scroll", "sway", "niri", "hyprland"])
    r.add_argument("--out", required=True)
    r.add_argument("--plugin", action="append", default=[])
    r.add_argument("--enabled")
    for name in ("list", "add", "enable", "disable", "update", "remove", "clone", "check"):
        x = psub.add_parser(name)
        x.add_argument("rest", nargs="*")

    args, rest = ap.parse_known_args(argv)
    if args.verb == "version":
        info = {"views-shell": VERSION, "protocol": PROTOCOL, "chromium": None}
        print(json.dumps(info) if args.json else f"views-shell {VERSION} (plugin protocol {PROTOCOL})")
    elif args.verb == "plugin" and args.pverb == "validate":
        cmd_validate(args)
    elif args.verb == "plugin" and args.pverb == "render":
        cmd_render(args)
    elif args.verb == "plugin" and args.pverb:
        forward(f"plugin/{args.pverb}", {"args": args.rest}, args.json)
    elif args.verb == "call":
        pid, _, cmd = args.plugin.partition("/")
        cmd = cmd or args.command
        if not cmd:
            die("call: name a command", 2)
        payload = json.loads(args.payload) if args.payload else {}
        forward("command/invoke", {"plugin": pid, "command": cmd, "args": payload, "source": "cli"}, args.json)
    elif args.verb == "open":
        forward("chrome/open", {"page": args.page}, args.json)
    elif args.verb is None and not rest:
        ap.print_help()
    else:
        # `views-shell <plugin-cli-name> <verb>` and the surface verbs are resolved by
        # the running views-shell against its registry.
        forward("cli/dispatch", {"argv": ([args.verb] if args.verb else []) + rest}, args.json)


if __name__ == "__main__":
    main(sys.argv[1:])
