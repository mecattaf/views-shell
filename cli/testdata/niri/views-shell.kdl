// begin example.music-scratchpad (generated by views-shell)
binds {
    F9 { spawn "views-shell" "call" "example.music-scratchpad" "toggle"; }
}
// end example.music-scratchpad

// begin example.power-menu (generated by views-shell)
binds {
    Mod+Shift+Escape { spawn "views-shell" "call" "example.power-menu" "toggle"; }
    Mod+Ctrl+L { spawn "views-shell" "call" "example.power-menu" "lock"; }
}
// end example.power-menu

// begin views-shell.workspace-rail (generated by views-shell)
binds {
    Mod+Grave { spawn "views-shell" "call" "views-shell.workspace-rail" "toggle-collapsed"; }
}
// end views-shell.workspace-rail
