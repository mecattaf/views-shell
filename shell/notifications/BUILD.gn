#
# The notifications seam (docs/architecture.md §8, docs/notifications.md): a
# freedesktop Notifications server on its own session-bus connection (//dbus,
# never //components/dbus), feeding //ui/message_center, whose popups are
# layer-shell surfaces. //views_shell lists this directory; the program starts
# it through NotificationService.

source_set("notifications") {
  sources = [
    "notification_server.cc",
    "notification_server.h",
    "notification_service.cc",
    "notification_service.h",
    "shell_message_popup_collection.cc",
    "shell_message_popup_collection.h",
  ]

  public_deps = [
    "//base",
    "//dbus",
    "//ui/display",
    "//ui/gfx",
    "//ui/message_center",
    "//ui/message_center/public/cpp",
    "//ui/platform_window",
    "//ui/views",
  ]

  deps = [
    "//ui/base",
    "//url",
  ]

  # //components/dbus is not a dependency of this target (gn desc deps); it
  # cannot be asserted away transitively, because Ozone's Wayland platform
  # already reaches it (ui/ozone/platform/wayland -> //ui/base/clipboard:
  # clipboard_util_linux -> //components/dbus), docs/notifications.md.
  assert_no_deps = [
    "//ash/*",
    "//chrome/*",
    "//chromeos/*",
    "//content/*",
  ]
}

# Run by views_shell_unittests. Notification* and ShellMessagePopup*:
#   NotificationServerMappingTest      in-process mapping, no bus, no display
#   NotificationServerBusTest          a real session bus (dbus-run-session);
#                                      skips when DBUS_SESSION_BUS_ADDRESS is unset
#   ShellMessagePopupSurfaceSpecTest   the layer-surface request, pure
#   ShellMessagePopupCollectionTest,
#   NotificationServiceTest            views::ViewsTestBase; need a Wayland
#                                      display (a private headless scroll under
#                                      runtime-test on the bench), skip without
source_set("unittests") {
  testonly = true

  sources = [
    "notification_server_unittest.cc",
    "shell_message_popup_collection_unittest.cc",
  ]

  deps = [
    ":notifications",
    "//base",
    "//base/test:test_support",
    "//dbus",
    "//mojo/core/embedder",
    "//testing/gtest",
    "//ui/accessibility:test_support",
    "//ui/base",
    "//ui/gl:test_support",
    "//ui/message_center",
    "//ui/message_center/public/cpp",
    "//ui/views",
    "//ui/views:test_support",
  ]

  # ViewsTestBase's resources (ui/base strings and images), as the stock
  # Views test suites load them.
  data_deps = [ "//ui/resources:ui_test_pak" ]
}
