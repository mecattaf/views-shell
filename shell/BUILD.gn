#
# //views_shell inside a Chromium checkout at the pinned tag
# (tools/bench/worker/wire.sh copies shell/ to src/views_shell/, and
# patches/views-shell-build-gate.patch puts this target in the root gn_all).
#
# views-shell is a Views program, not a content embedder (rule R24). The lifted
# sources under app/cowl_*, host/, rail/, bar/*.cc and wm/ are provenance only
# and are not built; app/ holds the program: views_shell_main.cc (flags and
# widgets), shell_bootstrap.{h,cc} (process bring-up) and
# views_shell_context_factory.{h,cc} (the in-process viz host).

import("//build/config/ozone.gni")
import("//build/config/ui.gni")
import("//testing/test.gni")

assert(is_linux, "views-shell is an is_linux program. It never builds for ChromeOS.")
assert(!is_chromeos, "Port Ash, never link it.")
assert(use_ozone && ozone_platform_wayland,
       "views-shell draws only on Wayland surfaces.")

# Chrome's tab, ported (CHROME-PORT-LEDGER.md), and the workspace strip built
# from it. Copied, never linked: nothing here depends on //chrome.
source_set("tabs") {
  sources = [
    "tabs/glow_hover_controller.cc",
    "tabs/glow_hover_controller.h",
    "tabs/layout_constants.cc",
    "tabs/layout_constants.h",
    "tabs/tab.cc",
    "tabs/tab.h",
    "tabs/tab_close_button.cc",
    "tabs/tab_close_button.h",
    "tabs/tab_color_id.h",
    "tabs/tab_color_mixer.cc",
    "tabs/tab_color_mixer.h",
    "tabs/tab_slot_controller.h",
    "tabs/tab_slot_view.cc",
    "tabs/tab_slot_view.h",
    "tabs/tab_strip_layout_types.h",
    "tabs/tab_strip_types.h",
    "tabs/tab_style.cc",
    "tabs/tab_style.h",
    "tabs/tab_style_views.cc",
    "tabs/tab_style_views.h",
    "tabs/tab_title.cc",
    "tabs/tab_title.h",
    "tabs/tab_view_vertical_layout.cc",
    "tabs/tab_view_vertical_layout.h",
    "tabs/unpinned_tab_container_view_layout.cc",
    "tabs/unpinned_tab_container_view_layout.h",
    "tabs/vertical_tab_style_views.cc",
    "tabs/vertical_tab_style_views.h",
    "tabs/workspace_source.cc",
    "tabs/workspace_source.h",
    "tabs/workspace_strip.cc",
    "tabs/workspace_strip.h",
  ]

  deps = [
    "tabs/vector_icons",
    "//base",
    "//cc/paint",
    "//skia",
    "//ui/accessibility",
    "//ui/aura",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/animation",
    "//ui/gfx/geometry",
    "//ui/views",
  ]

  assert_no_deps = [
    "//ash/*",
    "//chrome/*",
    "//chromeos/*",
    "//content/*",
  ]
}

# The registered chapter-2 seams. GN only generates targets in BUILD.gn files
# reachable from this root, so the root lists every seam now and later items
# fill their own directory without editing this file.
views_shell_seams = [
  "bar",
  "notifications",
  "plugins",
  "style",
  "ui_tree",
  "wm",
]

# Rules R1, R5 and R24, enforced by the build: no //chrome, no //ash, no
# //chromeos, and no browser: no //content, no Blink renderer, no V8.
#
# Finding F3 (docs/bench/views-shell-154.md): the stock Views stack reaches
# //v8 and //third_party/blink/renderer through //third_party/blink/public:blink_headers
# (from //ui/events/blink and //ui/events/gestures/blink) and through
# //services/webnn/public/mojom:webnn_mojom_traits. Those edges are cut by
# patches/views-shell-blink-renderer-edges.patch, so the whole trees are guarded.
views_shell_no_deps = [
  "//ash/*",
  "//chrome/*",
  "//chromeos/*",
  "//content/*",
  "//gin/*",
  "//third_party/blink/renderer/*",
  "//v8/*",
]

executable("views_shell") {
  # Debt D1 is paid (docs/architecture.md): the context factory is the
  # production in-process viz host in app/views_shell_context_factory.cc, and
  # nothing here is test support.
  testonly = false

  sources = [
    "app/shell_bootstrap.cc",
    "app/shell_bootstrap.h",
    "app/views_shell_context_factory.cc",
    "app/views_shell_context_factory.h",
    "app/views_shell_main.cc",
  ]

  deps = [
    ":tabs",
    "//base",
    "//base:i18n",
    "//cc",
    "//cc/mojo_embedder",
    "//components/discardable_memory/service",
    "//components/viz/common",
    "//components/viz/host",
    "//components/viz/service",
    "//components/viz/service/main",
    "//gpu/command_buffer/client:raster_interface",
    "//gpu/command_buffer/common",
    "//gpu/command_buffer/service:gles2",
    "//gpu/config",
    "//gpu/ipc/client",
    "//gpu/ipc/common",
    "//gpu/ipc/service",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//services/viz/privileged/mojom",
    "//services/viz/privileged/mojom/compositing",
    "//services/viz/privileged/mojom/gl",
    "//services/viz/public/cpp/gpu",
    "//skia",
    "//ui/accessibility",
    "//ui/aura",
    "//ui/base",
    "//ui/base/clipboard",
    "//ui/base/ime/init",
    "//ui/color",
    "//ui/color:mixers",
    "//ui/compositor",
    "//ui/display",
    "//ui/gfx",
    "//ui/gl",
    "//ui/menus",
    "//ui/ozone",
    "//ui/platform_window",
    "//ui/views",
    "//ui/wm",
    "//url",
  ]
  deps += views_shell_seams

  # Debt D2 (docs/architecture.md): the resources are ui_test_pak (a plain
  # copy() on Linux, not testonly) until views-shell repacks its own pak.
  data_deps = [ "//ui/resources:ui_test_pak" ]

  assert_no_deps = views_shell_no_deps
}

# The unit-test umbrella. Each seam contributes its own :unittests source_set;
# with none filled yet it builds and runs zero tests.
test("views_shell_unittests") {
  deps = [
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
  foreach(seam, views_shell_seams) {
    deps += [ "$seam:unittests" ]
  }

  assert_no_deps = views_shell_no_deps
}
