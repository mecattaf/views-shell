#
# //views_shell inside a Chromium checkout at the pinned tag
# (tools/bench/worker/wire.sh copies shell/ to src/views_shell/, and
# patches/views-shell-build-gate.patch puts this target in the root gn_all).
#
# views-shell is a Views program, not a content embedder (rule R24). The lifted
# sources under app/cowl_*, host/, rail/ and wm/ are provenance only and are not
# built; app/views_shell_main.cc is new and shaped like
# ui/views/examples/examples_main_proc.cc.

import("//build/config/ozone.gni")
import("//build/config/ui.gni")

assert(is_linux, "views-shell is an is_linux program. It never builds for ChromeOS.")
assert(!is_chromeos, "Port Ash, never link it.")
assert(use_ozone && ozone_platform_wayland,
       "views-shell draws only on Wayland surfaces.")

executable("views_shell") {
  # Debt D1 (docs/architecture.md): the context factory comes from
  # //ui/compositor:test_support until the production in-process viz host
  # exists, so the executable is testonly until D1 is paid.
  testonly = true

  sources = [ "app/views_shell_main.cc" ]

  deps = [
    "//base",
    "//base:i18n",
    "//base/test:test_support",
    "//mojo/core/embedder",
    "//skia",
    "//ui/accessibility",
    "//ui/aura",
    "//ui/base",
    "//ui/base/ime/init",
    "//ui/color",
    "//ui/compositor",
    "//ui/compositor:test_support",
    "//ui/display",
    "//ui/gfx",
    "//ui/gl",
    "//ui/gl/init",
    "//ui/ozone",
    "//ui/platform_window/common",
    "//ui/views",
    "//ui/wm",
  ]

  data_deps = [ "//ui/resources:ui_test_pak" ]

  # Rules R1, R5 and R24, enforced by the build: no //chrome, no //ash, no
  # //chromeos, and no browser: no //content, no Blink renderer, no V8 engine.
  #
  # Finding F3 (docs/bench/views-shell-154.md): the stock Views stack, as in
  # views_examples, reaches //v8:cppgc_headers, //v8:v8_libbase,
  # //v8:v8_libplatform, //third_party/blink/renderer/platform/wtf and Blink
  # code-generation actions through //components/viz/host ->
  # //components/input -> //ui/events/blink -> //third_party/blink/public:blink_headers.
  # So `//v8/*` and `//third_party/blink/renderer/*` cannot be guarded whole
  # without cutting that edge upstream; the guard names the engine and the
  # renderer instead, and `gn path` to //v8, //content, Blink core and platform,
  # //chrome and //ash prints "No non-data paths".
  assert_no_deps = [
    "//chrome/*",
    "//ash/*",
    "//chromeos/*",
    "//content/*",
    "//gin/*",
    "//third_party/blink/renderer/bindings/core/*",
    "//third_party/blink/renderer/bindings/modules/*",
    "//third_party/blink/renderer/controller/*",
    "//third_party/blink/renderer/core:core",
    "//third_party/blink/renderer/modules:modules",
    "//third_party/blink/renderer/platform:platform",
    "//v8:cppgc_base",
    "//v8:v8",
    "//v8:v8_base",
    "//v8:v8_base_without_compiler",
    "//v8:v8_compiler",
    "//v8:v8_initializers",
    "//v8:v8_snapshot",
  ]
}
