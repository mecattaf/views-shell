#
# agency Ozone Patch: layer-shell host source_set.
#
# This source_set mirrors the hunk that `agency/patches/cowl-source.patch`
# (and its //agency/patches:cowl-source equivalent, the shared/aggregate
# patch the orchestrator wires) adds directly into the upstream
# //ui/ozone/platform/wayland:wayland source_set. It is provided here so
# this subdir is independently buildable/lintable; the orchestrator's
# aggregate BUILD.gn is the one that actually links these files into the
# real //ui/ozone/platform/wayland target inside a patched Chromium tree.
#
# See PROVENANCE.md for the lift ledger and the configure-before-buffer
# invariant that must survive every future edit to this directory.

import("//build/config/linux/pkg_config.gni")

source_set("layer_shell") {
  sources = [
    "wayland_layer_shell.cc",
    "wayland_layer_shell.h",
    "wayland_layer_shell_window.cc",
    "wayland_layer_shell_window.h",
  ]

  defines = [ "IS_OZONE_IMPL" ]

  deps = [
    "//agency/build:cowl_buildflags",
    "//base",
    "//ui/gfx/geometry",
    "//ui/ozone/platform/wayland:common",
    "//ui/ozone/platform/wayland:wayland",
    "//ui/platform_window",

    # zwlr_layer_shell_v1 protocol bindings (the .xml -> client-protocol.h
    # generated header consumed via the `#define namespace namespace_`
    # workaround in both .cc files).
    "//third_party/wayland-protocols:wlr_layer_shell_protocol",

    # ext-background-effect-v1 blur support, gated independently at the
    # BUILD.gn level by cowl_has_background_effect (see
    # BUILDFLAG(COWL_HAS_BACKGROUND_EFFECT) in wayland_layer_shell_window.cc).
    "//third_party/wayland-protocols:ext_background_effect_protocol",
  ]

  public_deps = [
    # WaylandWindow base class + WaylandConnection/WaylandSurface/
    # WaylandOutput(Manager)/WaylandWindowManager friends this code calls
    # directly (connection()->layer_shell(), connection()->compositor(),
    # root_surface(), wayland_output_manager(), window_manager()).
    "//ui/ozone/platform/wayland:wayland",
  ]
}
