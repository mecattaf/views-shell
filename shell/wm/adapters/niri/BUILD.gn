# chromium/src/agency/signal/niri/BUILD.gn
#
# NiriIpcClient -- the SignalSource control seam. Owns the single $NIRI_SOCKET
# AF_UNIX connection to the niri compositor, does the EventStream handshake, and
# decodes the NDJSON single-key event stream into typed agency::niri::Event
# values dispatched to the workspace/window/output producer callbacks.
#
# No mojom dependency: this seam speaks niri's JSON IPC, not agency.mojom. It is
# a pure //base client (base::MessagePumpForIO fd watch + base::JSONReader), so
# the producers layered above it are the ones that own the mojom surface. The
# orchestrator wires this source_set into the shell's signal aggregate.

source_set("niri") {
  sources = [
    "niri_events.cc",
    "niri_events.h",
    "niri_ipc_client.cc",
    "niri_ipc_client.h",
  ]

  deps = [
    # base::MessagePumpForIO::FdWatcher, base::JSONReader/base::Value,
    # base::ScopedFD, base::WeakPtrFactory, base::RandDouble, the sequenced
    # task runner, logging -- the whole client is built on //base.
    "//base",
  ]
}
