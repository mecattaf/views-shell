@@ -317,6 +317,12 @@ void WaylandSurface::set_opaque_region(
   if (!root_window_)
     return;
 
+  // COWL: never advertise an opaque region. Stock Chromium declares translucent
+  // layer-shell surfaces opaque (full size_px), so niri skips compositing the
+  // wallpaper behind a bogus rect -> the "black box". An empty opaque region is
+  // always correct (it is only an optimization hint).
+  region_px.reset();
+
   if (region_px)
     pending_state_.opaque_region_px = *region_px;
 
