   virtual WaylandBubble* AsWaylandBubble();
   virtual WaylandPopup* AsWaylandPopup();
   virtual WaylandToplevelWindow* AsWaylandToplevelWindow();
+  // Agency (enabler #4): down-cast to WaylandLayerShellWindow if |this| is one.
