+  virtual WaylandLayerShellWindow* AsWaylandLayerShellWindow();
 
   scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner() {
     return ui_task_runner_;
diff --git a/ui/ozone/platform/wayland/host/xdg_popup.cc b/ui/ozone/platform/wayland/host/xdg_popup.cc
index 94987c9..2dbd0e7 100644
--- a/ui/ozone/platform/wayland/host/xdg_popup.cc
+++ b/ui/ozone/platform/wayland/host/xdg_popup.cc
@@ -25,6 +25,18 @@
 #include "ui/ozone/platform/wayland/host/xdg_toplevel.h"
 #include "ui/ozone/public/ozone_switches.h"
 
+#include "cowl/build/cowl_buildflags.h"
+
+#if BUILDFLAG(ENABLE_COWL_LAYER_SHELL)
+#include "ui/ozone/platform/wayland/host/wayland_layer_shell_window.h"
+// 'namespace' is a C++ keyword but is used as a parameter name in the
+// wlr-layer-shell protocol XML. Work around the generated C header, matching
+// wayland_layer_shell_window.cc.
+#define namespace namespace_
+#include <wlr-layer-shell-unstable-v1-client-protocol.h>
+#undef namespace
+#endif
+
 namespace ui {
 
 namespace {
@@ -133,6 +145,15 @@ bool XdgPopup::Initialize(const InitParams& params) {
     NOTREACHED() << "xdg_popup does not have a valid parent xdg_surface";
   }
 
+#if BUILDFLAG(ENABLE_COWL_LAYER_SHELL)
+  // Agency (enabler #4): a wlr-layer-shell parent (the bar/dock) has no
+  // xdg_surface. When the resolved xdg-parent is a layer surface, the xdg_popup
+  // is created with a NULL xdg parent and then parented onto the layer surface
+  // via zwlr_layer_surface_v1.get_popup (both before the initial commit).
+  WaylandLayerShellWindow* parent_layer =
+      xdg_parent->AsWaylandLayerShellWindow();
+#endif
+
   struct xdg_surface* parent_xdg_surface = nullptr;
   // If the xdg_parent window is a popup, the surface of that popup must be used
   // as a parent to create this xdg_popup.
@@ -142,11 +163,19 @@ bool XdgPopup::Initialize(const InitParams& params) {
     parent_xdg_surface = parent_toplevel->xdg_toplevel()->xdg_surface();
   }
 
+#if BUILDFLAG(ENABLE_COWL_LAYER_SHELL)
+  CHECK(xdg_surface_ && (parent_xdg_surface || parent_layer));
+
+  if (!xdg_surface_ || (!parent_xdg_surface && !parent_layer)) {
+    return false;
+  }
+#else
   CHECK(xdg_surface_ && parent_xdg_surface);
 
   if (!xdg_surface_ || !parent_xdg_surface) {
     return false;
   }
+#endif
 
   params_ = params;
   // Wayland doesn't allow empty bounds. If a zero or negative size is set, the
@@ -161,8 +190,34 @@ bool XdgPopup::Initialize(const InitParams& params) {
     return false;
   }
 
+#if BUILDFLAG(ENABLE_COWL_LAYER_SHELL)
+  if (parent_layer) {
+    // wlr-layer-shell: the xdg_popup is created with a NULL xdg parent, then
+    // parented onto the layer surface via zwlr_layer_surface_v1.get_popup.
+    // Both requests MUST precede the popup's initial commit, performed by
+    // window()->root_surface()->Commit() at the end of this function.
+    if (!parent_layer->layer_surface()) {
+      // The layer parent has no live layer surface (it is not currently
+      // mapped), so it cannot adopt the popup via get_popup. Refuse rather
+      // than fall through and commit an xdg_popup that was created with a
+      // NULL parent and never parented -- an unparented xdg_popup is an
+      // xdg_wm_base protocol error at commit time.
+      return false;
+    }
+    xdg_popup_.reset(
+        xdg_surface_get_popup(xdg_surface(), nullptr, positioner.get()));
+    if (xdg_popup_) {
+      zwlr_layer_surface_v1_get_popup(parent_layer->layer_surface(),
+                                      xdg_popup_.get());
+    }
+  } else {
+    xdg_popup_.reset(xdg_surface_get_popup(xdg_surface(), parent_xdg_surface,
+                                           positioner.get()));
+  }
+#else
   xdg_popup_.reset(xdg_surface_get_popup(xdg_surface(), parent_xdg_surface,
                                          positioner.get()));
+#endif
   if (!xdg_popup_) {
     return false;
   }
