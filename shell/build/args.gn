is_component_build = true
use_ozone = true
ozone_auto_platforms = false
ozone_platform_wayland = true
ozone_platform = "wayland"
enable_cowl_layer_shell = true

# Agency (views-shell) link-gate. Drives BUILDFLAG(ENABLE_AGENCY) and the
# //agency:agency group reached from the root gn_all group (see
# patches/agency-build-gate.patch). The deferred producer bands stay off via
# their own default-false args in //agency/build/agency.gni.
enable_agency = true

# Q1 inbound-server coexistence spike (RULINGS-LEDGER Part D Q1). Pulls in
# //agency/server and makes //agency/shell stand the server up under
# --agency-inbound-server. Rung-4 Views blit stays off (separate arg).
agency_enable_inbound_server = true

target_os = "linux"
is_debug = false
symbol_level = 1
