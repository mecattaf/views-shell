{
  "$schema": "../../schemas/views-shell-plugin.schema.json",
  "schemaVersion": 1,
  "id": "views-shell.qs-power-footer",
  "name": "Power footer (quick settings)",
  "version": "0.1.0",
  "description": "The first-party footer: battery, power profile, the settings gear that opens the views-shell control pages in Chrome, lock, and the power menu. A T1 plugin with no code.",
  "license": "BSD-3-Clause",
  "engines": { "views-shell": ">=0.1.0 <0.2.0" },
  "runtime": { "mode": "declarative" },
  "permissions": ["call:views-shell.session/lock", "call:views-shell.session/power-menu"],
  "requires": { "plugins": ["views-shell.power", "views-shell.session"] },
  "contributes": {
    "commands": [
      { "id": "open-settings", "title": "Open views-shell settings", "icon": "settings", "handler": { "open": "settings" } }
    ],
    "quickSettings": [
      { "id": "footer", "slot": "footer", "ui": "ui/footer.json", "state": "views-shell.power/state" }
    ]
  }
}
