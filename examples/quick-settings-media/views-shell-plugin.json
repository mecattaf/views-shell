{
  "$schema": "../../schemas/views-shell-plugin.schema.json",
  "schemaVersion": 1,
  "id": "views-shell.qs-media",
  "name": "Media (quick settings)",
  "version": "0.1.0",
  "description": "The first-party now-playing cards, one per MPRIS session, drawn by the stock MediaItemUIView. A T1 plugin with no code.",
  "license": "BSD-3-Clause",
  "engines": { "views-shell": ">=0.1.0 <0.2.0" },
  "runtime": { "mode": "declarative" },
  "permissions": ["call:views-shell.media/control"],
  "requires": { "plugins": ["views-shell.media"] },
  "contributes": {
    "quickSettings": [
      { "id": "sessions", "slot": "card", "ui": "ui/card.json", "state": "views-shell.media/state", "when": "session.mediaActive" }
    ]
  }
}
